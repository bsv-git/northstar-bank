BANK_DB_USER=demobank
BANK_DB_PASSWORD=replace-with-a-local-password
BANK_INTERNAL_SECRET=replace-with-a-long-random-secret
PODMAN_NETWORK=demobank-net
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8080
# Comma-separated browser origins allowed to call the gateway.
APP_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Use the local WSL Postfix listener when configured; capture is safe for tests.
EMAIL_MODE=smtp
EMAIL_FROM=no-reply@northstar.local
EMAIL_CAPTURE_DIR=/tmp/northstar-email-capture
SMTP_HOST=host.containers.internal
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
